{
    "name": "zana/cache",
    "description": "Caching abstraction for Zana applications",
    "type": "library",
    "keywords": ["zana", "cache", "caching"],
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Cache\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

