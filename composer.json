{
    "name": "mj-zana/cache",
    "description": "PSR-16 caches (array, file, null) with remember() for Zana applications",
    "type": "library",
    "keywords": ["zana", "cache", "psr-16", "simple-cache"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/core": "^2.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "provide": {
        "psr/simple-cache-implementation": "3.0"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Cache\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.3.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.3.0" } } },
        { "type": "path", "url": "../zana-core", "options": { "symlink": true, "versions": { "mj-zana/core": "2.3.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
